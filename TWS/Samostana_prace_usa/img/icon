// Cookie consent modal
(function () {
  function initCookieConsentModal() {
    var cookieAnalytics = "cookie_analytics";
    var cookieMarketing = "cookie_marketing";
    var cookieAfterApprovals = "cookies_after_approvals";
    var hasCookieAnswer = window.pixAllGTM.getCookie(cookieAfterApprovals) === "true";
    var dataLayerNamesForCookieUpdate = ["dataLayer", "newDataLayer", "stapeDataLayer"];
    if (!hasCookieAnswer) {
      document.querySelector(".jw-modal").classList.add("open");
    }
    if (document.getElementById("manage-cookies")) {
      document.getElementById("manage-cookies").addEventListener("click", function () {
        document.querySelector(".jw-modal-body").classList.add("show-cookies-details");
      });
      document.getElementById("back-cookies").addEventListener("click", function () {
        document.querySelector(".jw-modal-body").classList.remove("show-cookies-details");
      });
      document.getElementById("analytic_check").addEventListener("change", function () {
        if (this.checked) {
          document.getElementById("analytics_desc").style.display = "block";
        } else {
          document.getElementById("analytics_desc").style.display = "none";
        }
      });
      document.getElementById("marketing_check").addEventListener("change", function () {
        if (this.checked) {
          document.getElementById("marketing_desc").style.display = "block";
        } else {
          document.getElementById("marketing_desc").style.display = "none";
        }
      });
      document.querySelector("button.save").addEventListener("click", function () {
        var inputs = document.querySelectorAll(".switch input");
        //document.cookie = "cookies_after_approvals=true";
        window.pixAllGTM.setCookie(cookieAfterApprovals, "true");
        var cookie_analytics_status = inputs[1].checked ? "granted" : "denied";
        var cookie_marketing_status = inputs[2].checked ? "granted" : "denied";

        //document.cookie = "cookie_analytics=" + cookie_analytics_status;
        window.pixAllGTM.setCookie(cookieAnalytics, cookie_analytics_status);
        //document.cookie = "cookie_marketing=" + cookie_marketing_status;
        window.pixAllGTM.setCookie(cookieMarketing, cookie_marketing_status);
        document.querySelector(".jw-modal").classList.remove("open");
        window.pixAllGTM.updateConsent({
          event: cookieMarketing,
          cookie_necessary: true,
          cookie_preferences: true,
          cookie_analytics: inputs[1].checked,
          cookie_marketing: inputs[2].checked,
          ad_personalization: inputs[2].checked,
          ad_user_data: inputs[2].checked
        }, dataLayerNamesForCookieUpdate);
      });
      document.querySelector("button.save-accept-all").addEventListener("click", function () {
        //document.cookie = "cookies_after_approvals=true";
        window.pixAllGTM.setCookie(cookieAfterApprovals, "true");
        //document.cookie = "cookie_analytics=granted";
        window.pixAllGTM.setCookie(cookieAnalytics, "granted");
        //document.cookie = "cookie_marketing=granted";
        window.pixAllGTM.setCookie(cookieMarketing, "granted");
        document.querySelector(".jw-modal").classList.remove("open");
        window.pixAllGTM.updateConsent({
          event: cookieMarketing,
          cookie_necessary: true,
          cookie_preferences: true,
          cookie_analytics: true,
          cookie_marketing: true,
          ad_personalization: true,
          ad_user_data: true
        }, dataLayerNamesForCookieUpdate);
      });
      document.querySelector("button.reject-all").addEventListener("click", function () {
        //document.cookie = "cookies_after_approvals=true";
        window.pixAllGTM.setCookie(cookieAfterApprovals, "true");
        //document.cookie = "cookie_analytics=denied";
        window.pixAllGTM.setCookie(cookieAnalytics, "denied");
        //document.cookie = "cookie_marketing=denied";
        window.pixAllGTM.setCookie(cookieMarketing, "denied");
        document.querySelector(".jw-modal").classList.remove("open");
        window.pixAllGTM.updateConsent({
          event: cookieMarketing,
          cookie_necessary: true,
          cookie_preferences: false,
          cookie_analytics: false,
          cookie_marketing: false,
          ad_personalization: false,
          ad_user_data: false
        }, dataLayerNamesForCookieUpdate);
      });
    }
  }
  initCookieConsentModal();
})();
